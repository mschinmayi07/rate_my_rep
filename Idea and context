DS Person 2 — Say vs. Do Score
This is the most important DS task:
pythonfrom sentence_transformers import SentenceTransformer, util
import numpy as np

model = SentenceTransformer('all-MiniLM-L6-v2')

def compute_say_vs_do(statements, votes):
    if len(statements) < 2 or len(votes) < 5:
        return {"score": None, "confidence": "insufficient data"}
    
    # Create vote descriptions
    vote_descriptions = [
        f"Voted {'YES' if v['vote']=='yes' else 'NO'} on {v['bill_title']} ({v['topic']})"
        for v in votes
    ]
    
    # Embed everything
    stmt_embeddings = model.encode(statements)
    vote_embeddings = model.encode(vote_descriptions)
    
    # Find low similarity pairs = potential contradictions
    contradictions = []
    for i, stmt in enumerate(statements):
        for j, vote_desc in enumerate(vote_descriptions):
            similarity = util.cos_sim(
                stmt_embeddings[i], 
                vote_embeddings[j]
            ).item()
            
            # Only flag potential contradictions
            if similarity < 0.2:
                contradictions.append({
                    "statement": stmt,
                    "vote": vote_desc,
                    "similarity": similarity
                })
    
    # Send top contradictions to AI for reasoning
    contradiction_scores = []
    for c in contradictions[:10]:  # limit AI calls
        score = ai_reason_contradiction(c['statement'], c['vote'])
        contradiction_scores.append(score)
    
    # Final score
    if not contradiction_scores:
        final_score = 85  # no contradictions found = high alignment
    else:
        avg_contradiction = np.mean(contradiction_scores)
        final_score = int(avg_contradiction * 20)
    
    confidence = (
        "insufficient data" if len(votes) < 5
        else "low confidence" if len(votes) < 15
        else "moderate confidence"
    )
    
    return {"score": final_score, "confidence": confidence}
AI/Agents Person — AI Contradiction Reasoning
pythondef ai_reason_contradiction(statement, vote_description):
    prompt = f"""A politician made this statement: "{statement}"
    
They then: "{vote_description}"

Does this vote contradict the statement?
Rate 1-5 where:
1 = clear contradiction
3 = unrelated
5 = clearly consistent

Return ONLY valid JSON:
{{"score": X, "reason": "one sentence explanation"}}"""

    response = model.generate_content(prompt)
    result = json.loads(response.text)
    return result['score']

def generate_plain_english_vote(bill_title, vote):
    prompt = f"""Translate this Arizona legislative vote into 
    one plain English sentence for a non-political person.
    Neutral and factual. Under 20 words.
    
    Bill: {bill_title}
    Vote: {vote}"""
    
    return model.generate_content(prompt).text.strip()

def generate_rep_summary(rep_name, votes, statements, score):
    prompt = f"""Write a 3-sentence neutral summary of what 
    {rep_name} actually stands for based on their voting record.
    
    Their top voting topics: {votes}
    Their Say vs. Do score: {score}/100
    
    Be factual. No judgment. Cite specific votes."""
    
    return model.generate_content(prompt).text.strip()

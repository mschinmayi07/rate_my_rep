pythonimport json
import os
import time
from google import genai
from dotenv import load_dotenv

load_dotenv()

client = genai.Client(api_key=os.getenv("GEMINI_API_KEY"))
WORKING_MODEL = "gemini-2.0-flash"  # update with whatever worked

with open("az_reps_with_statements.json") as f:
    reps = json.load(f)

def compute_say_vs_do(rep):
    name = rep["name"]
    party = rep["party"]
    statements = rep.get("statements", [])
    bills = rep.get("bills", [])
    topic_breakdown = rep.get("topic_breakdown", {})
    
    # If no statements, skip
    if not statements:
        return {
            "score": None,
            "confidence": "insufficient data",
            "summary": f"No public statements found for {name}",
            "highlights": []
        }
    
    # Build context for Gemini
    statements_text = "\n".join([
        f"- {s.get('statement', '')}" 
        for s in statements[:10]  # Top 10 statements
    ])
    
    bills_text = "\n".join([
        f"- {b['title']} (topic: {b.get('topic', 'unknown')})"
        for b in bills[:15]
    ])
    
    top_topics = list(topic_breakdown.keys())[:3]
    
    prompt = f"""You are analyzing an Arizona state legislator.

Politician: {name} ({party})

Their PUBLIC STATEMENTS:
{statements_text}

Their SPONSORED BILLS this session:
{bills_text}

Their top legislative focus areas based on bills: {", ".join(top_topics)}

Task: Analyze whether this politician's public statements align with 
their actual legislative work (bills they sponsor).

Return a JSON object with exactly these fields:
{{
  "score": <number 1-100 where 100 = perfect alignment>,
  "confidence": <"high", "medium", or "low">,
  "summary": <one plain English sentence about their alignment>,
  "highlights": [
    {{
      "statement": <quote from their statements>,
      "reality": <what their bills show>,
      "aligned": <true or false>
    }}
  ]
}}

Be fair and factual. Return ONLY the JSON, no other text."""

    try:
        response = client.models.generate_content(
            model=WORKING_MODEL,
            contents=prompt
        )
        
        # Parse JSON from response
        text = response.text.strip()
        # Remove markdown code blocks if present
        text = text.replace("```json", "").replace("```", "").strip()
        return json.loads(text)
        
    except Exception as e:
        print(f"  Error for {name}: {e}")
        return {
            "score": None,
            "confidence": "error",
            "summary": "Could not compute score",
            "highlights": []
        }

# Compute for all reps
print("Computing Say vs. Do scores...")

for i, rep in enumerate(reps):
    print(f"[{i+1}/30] {rep['name']}...")
    
    result = compute_say_vs_do(rep)
    rep["say_vs_do"] = result
    
    if result["score"]:
        print(f"  Score: {result['score']}/100 "
              f"({result['confidence']} confidence)")
    else:
        print(f"  Score: N/A ({result['confidence']})")
    
    # Save after each rep
    with open("az_reps_scored.json", "w") as f:
        json.dump(reps, f, indent=2)
    
    time.sleep(2)

print("\nDone! Scores computed.")

# Summary
scored = [r for r in reps if r.get("say_vs_do", {}).get("score")]
print(f"Reps with scores: {len(scored)}/30")
if scored:
    avg = sum(r["say_vs_do"]["score"] for r in scored) / len(scored)
    print(f"Average score: {avg:.1f}/100")
    
    # Find most interesting ones for demo
    print("\n=== BEST DEMO CANDIDATES ===")
    sorted_reps = sorted(
        scored, 

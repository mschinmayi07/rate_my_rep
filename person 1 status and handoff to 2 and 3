pythonimport requests
import json
import os
from dotenv import load_dotenv

load_dotenv()

API_KEY = os.getenv("OPENSTATES_API_KEY")
BASE_URL = "https://v3.openstates.org"
headers = {"X-API-KEY": API_KEY}

def get_rep_by_zip(zipcode):
    """Returns rep names for a given AZ zip code"""
    response = requests.get(
        f"{BASE_URL}/people/geo",
        headers=headers,
        params={"address": f"{zipcode}, Arizona, USA"}
    )
    
    if response.status_code != 200:
        return []
    
    data = response.json()
    return [
        {
            "name": p["name"],
            "id": p["id"],
            "district": p.get("current_role", {}).get("district"),
            "chamber": p.get("current_role", {}).get("org_classification")
        }
        for p in data.get("results", [])
    ]


pythonimport requests
import json
import os
import time
from dotenv import load_dotenv

load_dotenv()

TINYFISH_KEY = os.getenv("TINYFISH_API_KEY")

with open("az_reps_final.json") as f:
    reps = json.load(f)

def scrape_ballotpedia(rep_name):
    """Scrape public statements from Ballotpedia"""
    
    # Format name for Ballotpedia URL
    url_name = rep_name.replace(" ", "_")
    url = f"https://ballotpedia.org/{url_name}"
    
    response = requests.post(
        "https://agent.tinyfish.ai/v1/automation/run-sse",
        headers={
            "X-API-Key": TINYFISH_KEY,
            "Content-Type": "application/json"
        },
        json={
            "url": url,
            "goal": """Extract all political quotes, public statements, 
                      and positions stated by this politician.
                      Return as JSON array: 
                      [{"statement": "...", "topic_hint": "..."}]
                      If page not found or no statements, return empty array: []"""
        },
        stream=True
    )
    
    # Parse SSE stream
    for line in response.iter_lines():
        if line:
            line_str = line.decode("utf-8")
            if line_str.startswith("data: "):
                try:
                    event = json.loads(line_str[6:])
                    if event.get("type") == "COMPLETE" and \
                       event.get("status") == "COMPLETED":
                        result = event.get("resultJson", [])
                        if isinstance(result, list):
                            return result
                        return []
                except:
                    continue
    return []

# Process reps in batches of 2 (TinyFish free = 2 concurrent)
# But run sequentially to be safe with 500 steps
results = []

for i, rep in enumerate(reps):
    rep_name = rep["name"]
    print(f"[{i+1}/30] Scraping {rep_name}...")
    
    statements = scrape_ballotpedia(rep_name)
    rep["statements"] = statements
    
    print(f"  Got {len(statements)} statements")
    
    # Save after every rep — don't lose progress
    with open("az_reps_with_statements.json", "w") as f:
        json.dump(reps, f, indent=2)
    
    time.sleep(3)  # Respect TinyFish rate limits

print("\nDone! Statements scraped.")

# Summary
total_statements = sum(len(r["statements"]) for r in reps)
reps_with_statements = sum(1 for r in reps if len(r["statements"]) > 0)
print(f"Reps with statements: {reps_with_statements}/30")
print(f"Total statements: {total_statements}")
